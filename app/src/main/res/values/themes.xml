<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NusukAI" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/nusuk_primary</item>
        <item name="colorOnPrimary">@color/nusuk_on_primary</item>
        <item name="colorSecondary">@color/nusuk_secondary</item>
        <item name="colorOnSecondary">@color/nusuk_on_secondary</item>
        <item name="colorSurface">@color/nusuk_card</item>
        <item name="colorOnSurface">@color/nusuk_text</item>
        <item name="colorOnSurfaceVariant">@color/nusuk_text_secondary</item>
        <item name="colorOutline">@color/nusuk_outline</item>
        <item name="colorError">@color/nusuk_error</item>
        <item name="android:colorBackground">@color/nusuk_bg</item>
        <item name="android:statusBarColor">@color/brand_green_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Nusuk.Medium</item>
    </style>

    <style name="ShapeAppearance.Nusuk.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="Theme.NusukAI.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_green_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.NusukAI</item>
    </style>

    <style name="Text.Title" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/nusuk_text</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Text.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/nusuk_text</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>
    <style name="Text.Secondary" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/nusuk_text_secondary</item>
    </style>

    <style name="Widget.Nusuk.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/nusuk_card</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">2dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>
</resources>
