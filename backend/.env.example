# Copy this file to ".env" (local) or set the same names as environment
# variables on your hosting provider. NEVER commit a real ".env" file.

PORT=8080

# demo | anthropic | openai
# "demo" works with no key at all. Real AI needs a provider + key below.
AI_PROVIDER=demo

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- OpenAI or any OpenAI-compatible API ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# Requests allowed per client IP per minute
RATE_LIMIT_PER_MIN=20

# Set to true ONLY if your host puts a trusted reverse proxy in front
# (Render, Railway, Fly.io, ...) so the real client IP is read from X-Forwarded-For.
TRUST_PROXY=false
